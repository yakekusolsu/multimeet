{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["chrome", "vite/client"],
    "allowImportingTsExtensions": true
  },
  "include": ["src", "../web/src/core", "../shared/src"],
  "exclude": ["../web/src/**/*.test.ts", "../shared/src/**/*.test.ts"]
}
